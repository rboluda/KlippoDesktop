{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klippo",
  "version": "../package.json",
  "identifier": "es.rboluda.klippo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Klippo",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/Klippo/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "rboluda",
    "copyright": "© 2026 rboluda · GPL-3.0-or-later",
    "homepage": "https://github.com/rboluda/KlippoDesktop",
    "shortDescription": "Descarga, recorta y comparte vídeos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binarios/yt-dlp.exe": "binarios/yt-dlp.exe",
      "binarios/deno.exe": "binarios/deno.exe",
      "binarios/versiones.json": "binarios/versiones.json",
      "binarios/ffmpeg/*": "binarios/ffmpeg/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3RDIzNjc5NjcyOTA0NUEKUldSYUJDbG5lVGJTZDlhUzhGdFRSMWplS1c3Uys4b3hRZm9GOE1xMDJWd1NISGM3YmJLSFk2ZGIK",
      "endpoints": [
        "https://github.com/rboluda/KlippoDesktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
